# Ключ Claude API. Без него два LLM-агента просто держат позицию (HOLD), остальные 8 работают.
ANTHROPIC_API_KEY=

# Источник котировок: binance | bybit | synthetic (synthetic только для тестов)
MARKET_SOURCE=binance
SYMBOL=BTCUSDT
TIMEFRAME=1h

# Стартовый виртуальный баланс каждого агента (USDT)
AGENT_START_BALANCE=1000

# Комиссия биржи за сделку (0.001 = 0.1%)
FEE_RATE=0.001

# Лимиты риска (доли от капитала)
AGENT_DAILY_LOSS_LIMIT=0.03
AGENT_MAX_DRAWDOWN=0.10
DEPT_DAILY_LOSS_LIMIT=0.02

# Автоматически нанимать замену уволенному агенту из скамейки запасных
AUTO_HIRE=true

# Модель Claude для LLM-агентов и руководителя
LLM_MODEL=claude-opus-5

# Путь к базе данных
DB_PATH=data/trader.db

# Порт веб-панели
PORT=8080

# Пароль на панель (логин любой). Обязательно задайте, если сервер доступен из интернета.
PANEL_PASSWORD=

# Свободный режим нейро-агентов: они сами выбирают, через сколько минут проверить рынок снова,
# в этих границах. Меньший минимум = больше запросов к Claude и выше расходы.
LLM_MIN_INTERVAL_MIN=15
LLM_MAX_INTERVAL_MIN=360
