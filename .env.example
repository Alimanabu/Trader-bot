# Ключ Claude API. Без него аналитический отдел молчит, директор и все трейдеры работают по правилам.
ANTHROPIC_API_KEY=

# Источник котировок: binance | bybit | synthetic (synthetic только для тестов)
MARKET_SOURCE=binance
SYMBOL=BTCUSDT
TIMEFRAME=1h

# Стартовый виртуальный баланс каждого агента (USDT)
AGENT_START_BALANCE=1000

# Комиссия биржи за сделку (0.001 = 0.1%)
FEE_RATE=0.001

# Размер позиции. По умолчанию агент входит всем капиталом (AGENT_MAX_EXPOSURE=1.0), ограничение риска
# выключено (RISK_PER_TRADE=1.0). Консервативный вариант: AGENT_MAX_EXPOSURE=0.25 и RISK_PER_TRADE=0.01,
# тогда размер позиции считается от стоп-лосса так, чтобы потеря на сделке не превышала 1% капитала.
AGENT_MAX_EXPOSURE=1.0
RISK_PER_TRADE=1.0
STOP_ATR_MULT=2.0
STOP_COOLDOWN_MIN=30

# Лимиты риска (доли от капитала)
AGENT_DAILY_LOSS_LIMIT=0.03
AGENT_MAX_DRAWDOWN=0.10
DEPT_DAILY_LOSS_LIMIT=0.02

# Автоматически нанимать замену уволенному агенту из скамейки запасных
AUTO_HIRE=true

# Модель Claude для аналитического отдела и отчётов директора.
# claude-sonnet-5 примерно в 2,5 раза дешевле claude-opus-5 и укладывается в бюджет 1-2 $/день.
LLM_MODEL=claude-sonnet-5
# Сильная модель для редких важных вызовов: стратег развития, ревизор, отчёт директора (1-2 вызова в день).
# Например claude-fable-5-1 (в 5 раз дороже Sonnet 5 за токен). Пусто = та же модель, что LLM_MODEL.
LLM_MODEL_STRONG=

# Директор: премия в % от недельной прибыли (виртуальная), и сколько недель подряд с рейтингом ниже 30
# до предложения сменить директора.
DIRECTOR_BONUS_PCT=10
DIRECTOR_FAIL_WEEKS=2

# Внутридневной пересмотр: цена ушла против режима директора на столько % → распределение капитала
# меняется сразу (не чаще раза в INTRADAY_COOLDOWN_H часов), утром директор оценивает рынок заново.
INTRADAY_MOVE_PCT=1.5
INTRADAY_COOLDOWN_H=3

# Путь к базе данных
DB_PATH=data/trader.db

# Порт веб-панели
PORT=8080

# Пароль на панель (логин любой). Обязательно задайте, если сервер доступен из интернета.
PANEL_PASSWORD=

# Как часто аналитики обновляют взгляд на рынок (минуты). Новостной аналитик с веб-поиском дороже, поэтому реже.
ANALYST_INTERVAL_MIN=240
ANALYST_NEWS_INTERVAL_MIN=480

# Жёсткий потолок расходов на нейросеть в сутки (доллары). При достижении аналитики молчат
# до следующего дня, компания работает как обычно.
LLM_DAILY_BUDGET_USD=2.0

# Стратег развития: как часто (часы) пишет наблюдения и предложения. Память по режимам начинает влиять
# на решения директора после стольких дней данных.
STRATEGIST_INTERVAL_H=72
MEMORY_MIN_DAYS=10

# Компания: трейдеров всего (делится на три деска поровну) и стажёров
TEAM_SIZE=18
INTERN_COUNT=20
