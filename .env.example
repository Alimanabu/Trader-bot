# Ключ Claude API. Без него два LLM-агента просто держат позицию (HOLD), остальные 8 работают.
ANTHROPIC_API_KEY=

# Источник котировок: binance | bybit | synthetic (synthetic только для тестов)
MARKET_SOURCE=binance
SYMBOL=BTCUSDT
TIMEFRAME=1h

# Стартовый виртуальный баланс каждого агента (USDT)
AGENT_START_BALANCE=1000

# Комиссия биржи за сделку (0.001 = 0.1%)
FEE_RATE=0.001

# Размер позиции. Агент рискует на одной сделке не больше RISK_PER_TRADE капитала: размер позиции
# считается от стоп-лосса (STOP_ATR_MULT × ATR ниже входа), и сверху ограничен потолком AGENT_MAX_EXPOSURE.
# Пример: стоп на 2% ниже входа и риск 1% → позиция 50%, но потолок 0.25 оставит 25%.
AGENT_MAX_EXPOSURE=0.25
RISK_PER_TRADE=0.01
STOP_ATR_MULT=2.0
STOP_COOLDOWN_MIN=30

# Лимиты риска (доли от капитала)
AGENT_DAILY_LOSS_LIMIT=0.03
AGENT_MAX_DRAWDOWN=0.10
DEPT_DAILY_LOSS_LIMIT=0.02

# Автоматически нанимать замену уволенному агенту из скамейки запасных
AUTO_HIRE=true

# Модель Claude для LLM-агентов и руководителя.
# claude-sonnet-5 примерно в 2,5 раза дешевле claude-opus-5 и укладывается в бюджет 1-2 $/день.
LLM_MODEL=claude-sonnet-5

# Путь к базе данных
DB_PATH=data/trader.db

# Порт веб-панели
PORT=8080

# Пароль на панель (логин любой). Обязательно задайте, если сервер доступен из интернета.
PANEL_PASSWORD=

# Свободный режим нейро-агентов: они сами выбирают, через сколько минут проверить рынок снова,
# в этих границах. Меньший минимум = больше запросов к Claude и выше расходы.
LLM_MIN_INTERVAL_MIN=60
LLM_MAX_INTERVAL_MIN=360
LLM_NEWS_MIN_INTERVAL_MIN=240

# Жёсткий потолок расходов на нейросеть в сутки (доллары). При достижении нейро-агенты
# держат позицию до следующего дня, остальной отдел работает как обычно.
LLM_DAILY_BUDGET_USD=2.0
